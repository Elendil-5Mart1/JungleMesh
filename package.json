{
  "name": "junglemesh",
  "version": "0.1.0",
  "description": "Peer-to-peer desktop chat with separate windows (Discord-style, no central server)",
  "author": "NeuralKink",
  "license": "MIT",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:bob": "electron-vite dev -- --profile=bob",
    "dev:carol": "electron-vite dev -- --profile=carol",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist": "electron-vite build && electron-builder --win"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "b4a": "^1.9.0",
    "compact-encoding": "^3.5.2",
    "corestore": "^7.15.0",
    "electron-updater": "^6.8.9",
    "highlight.js": "^11.12.0",
    "hypercore-id-encoding": "^1.3.0",
    "hyperswarm": "^4.17.2",
    "i18next": "^26.4.6",
    "protomux": "^3.13.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.0.18",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "sass": "^1.105.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "electron-winstaller": false
  },
  "build": {
    "appId": "org.junglemesh.app",
    "productName": "JungleMesh",
    "publish": [
      {
        "provider": "github",
        "owner": "Elendil-5Mart1",
        "repo": "JungleMesh"
      }
    ],
    "protocols": {
      "name": "JungleMesh",
      "schemes": [
        "junglemesh"
      ]
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "npmRebuild": false,
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "**/prebuilds/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "JungleMesh-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    }
  }
}
