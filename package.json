{
  "name": "junglemesh",
  "version": "0.3.1",
  "description": "Peer-to-peer desktop chat with voice, video and screen sharing, no central server",
  "author": "NeuralKink",
  "homepage": "https://github.com/Elendil-5Mart1/JungleMesh",
  "license": "MIT",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:bob": "electron-vite dev -- --profile=bob",
    "dev:carol": "electron-vite dev -- --profile=carol",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist": "electron-vite build && electron-builder --win --publish never",
    "dist:linux": "electron-vite build && electron-builder --linux --publish never",
    "dist:mac": "electron-vite build && electron-builder --mac --publish never"
  },
  "dependencies": {
    "b4a": "^1.9.0",
    "compact-encoding": "^3.5.2",
    "corestore": "^7.15.0",
    "electron-updater": "^6.8.9",
    "hypercore-id-encoding": "^1.3.0",
    "hyperswarm": "^4.17.2",
    "i18next": "^26.4.6",
    "koffi": "^2.16.3",
    "protomux": "^3.13.0"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "emojibase-data": "^17.0.0",
    "highlight.js": "^11.12.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.0.18",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "sass": "^1.105.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "zustand": "^5.0.15"
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "electron-winstaller": false,
    "koffi": false
  },
  "build": {
    "appId": "org.junglemesh.app",
    "productName": "JungleMesh",
    "publish": [
      {
        "provider": "github",
        "owner": "Elendil-5Mart1",
        "repo": "JungleMesh"
      }
    ],
    "protocols": {
      "name": "JungleMesh",
      "schemes": [
        "junglemesh"
      ]
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "npmRebuild": false,
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "**/prebuilds/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "JungleMesh-Setup-${version}.${ext}",
      "files": [
        "!**/prebuilds/{android-*,darwin-*,ios-*,linux-*,win32-arm64}/**",
        "!**/node_modules/koffi/build/koffi/!(win32_x64)/**",
        "!**/node_modules/koffi/{src,vendor,doc,lib}/**"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "icon": "build/icon.png",
      "maintainer": "NeuralKink <107424575+Elendil-5Mart1@users.noreply.github.com>",
      "artifactName": "JungleMesh-${version}.${ext}",
      "desktop": {
        "entry": {
          "StartupWMClass": "junglemesh"
        }
      },
      "files": [
        "!**/prebuilds/{android-*,darwin-*,ios-*,win32-*,linux-arm64}/**",
        "!**/node_modules/koffi/**"
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.social-networking",
      "icon": "build/icon.png",
      "artifactName": "JungleMesh-${version}-${arch}.${ext}",
      "identity": "-",
      "hardenedRuntime": false,
      "notarize": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "JungleMesh uses the microphone for voice calls.",
        "NSCameraUsageDescription": "JungleMesh uses the camera for video calls."
      },
      "files": [
        "!**/prebuilds/{android-*,ios-*,linux-*,win32-*}/**",
        "!**/node_modules/koffi/**"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "electronLanguages": [
      "en-US",
      "fr"
    ]
  }
}
