<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.junglemesh.callservice" >

    <uses-sdk android:minSdkVersion="29" />
    <!-- Merged into the app's manifest at build time: no config plugin needed -->
    <!-- Foreground service (Android 9+) of type "microphone" (Android 14+) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Android 13+: without it, the call notification only shows in the task manager -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <service
            android:name="org.junglemesh.callservice.CallService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
    </application>

</manifest>